{
  "name": "resumeweave-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop client for ResumeWeave",
  "main": "main.cjs",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64", "dist:mac": "electron-builder --mac --x64 --arm64" },
  "devDependencies": { "electron": "^37.2.6", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "com.shuhuihuang.resumeweave",
    "productName": "ResumeWeave",
    "directories": { "output": "release" },
    "files": ["main.cjs", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity", "artifactName": "ResumeWeave-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "ResumeWeave-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "ResumeWeave-Portable-${version}-${arch}.${ext}" }
  }
}
